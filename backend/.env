# ================= DeepSeek（OpenAI 兼容接口）=================
# 必填：在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=""

# 可改：OpenAI 兼容 Base URL（DeepSeek 官方地址，保持默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可改：模型名（deepseek-chat = V3 支持 Function Calling；deepseek-reasoner = R1）
DEEPSEEK_MODEL=deepseek-chat

# ================= 后端服务 =================
# 后端监听端口（前端 Vite 代理会把 /api 转发到这个端口）
PORT=3001

# ================= MySQL =================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_demo
MYSQL_CONNECTION_LIMIT=10
AUTH_SECRET=change-me-in-production
