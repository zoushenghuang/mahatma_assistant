# ================= DeepSeek =================
# API Key 不再由服务端统一配置：每个用户登录后在「我的 Key」里填自己的，
# 加密存库、只用于本人会话。服务端这里只需配置模型名。

# 可改：OpenAI 兼容 Base URL（DeepSeek 官方地址，保持默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可改：模型名（deepseek-chat = V3 支持 Function Calling；deepseek-reasoner = R1）
DEEPSEEK_MODEL=deepseek-chat

# ================= 后端服务 =================
# 后端监听端口（前端 Vite 代理会把 /api 转发到这个端口）
PORT=3001

# JWT 签名密钥（登录态签发用，生产环境必须改成随机长字符串）
AUTH_SECRET=change-me-in-production-please

# ================= 天气 / 定位（可选）=================
# 高德地图 Web 服务 Key：配置后天气查询与定位走高德（国内稳定、可精确到区县）。
# 申请地址：https://console.amap.com/dev/key/app （Web 服务类型即可，免费额度足够）
# 不配置也能用：天气自动降级为 Open-Meteo（免 Key），定位精度略低
AMAP_KEY=

# ================= MySQL =================
# 本地 MySQL 地址
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的密码

# 库名（不存在时后端启动会自动创建）
MYSQL_DATABASE=agent_demo

# 连接池大小（可选）
MYSQL_CONNECTION_LIMIT=10
